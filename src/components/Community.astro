---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="community" class="py-24 px-4">
  <div class="container-dashboard">
    <h2 class="section-title">{t('community.title')}</h2>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <article class="modern-card text-center group">
        <div class="mb-6">
          <div class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-accent/20 to-accent/5 rounded-2xl border-2 border-accent flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <span class="text-5xl">🎮</span>
          </div>
        </div>
        
        <h3 class="text-primary font-pixel text-base md:text-lg mb-4">
          {t('community.gdupn.title')}
        </h3>
        
        <p class="text-light/80 text-sm mb-4 leading-relaxed">
          {t('community.gdupn.description')}
        </p>
        
        <div class="inline-block px-4 py-2 bg-surface rounded-lg text-light/60 text-xs border border-border">
          {t('community.gdupn.details')}
        </div>
      </article>
      
      <article class="modern-card group">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center border border-primary/30">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-primary font-pixel text-sm md:text-base">
              {t('community.spooky.title')}
            </h3>
            <p class="text-accent text-xs md:text-sm mt-1">
              {t('community.spooky.date')}
            </p>
          </div>
        </div>
        
        <p class="text-light/80 text-sm mb-4 leading-relaxed">
          {t('community.spooky.description')}
        </p>
        
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div class="bg-surface p-4 rounded-lg border border-border">
            <div class="text-primary font-pixel text-2xl mb-1">~30</div>
            <div class="text-light/60 text-xs">Attendees</div>
          </div>
          <div class="bg-surface p-4 rounded-lg border border-border">
            <div class="text-accent font-pixel text-2xl mb-1">4</div>
            <div class="text-light/60 text-xs">Teams</div>
          </div>
        </div>
        
        <p class="text-light/60 text-xs mb-4 leading-relaxed">
          {t('community.spooky.partners')}
        </p>
        
        <div class="flex gap-4 pt-4 border-t border-border">
          <a 
            href="https://lnkd.in/dGJ6Dnq9" 
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent text-xs font-semibold hover:underline flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            Reel 1
          </a>
          <a 
            href="https://lnkd.in/dUzmkRmr" 
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent text-xs font-semibold hover:underline flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            Reel 2
          </a>
        </div>
      </article>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="modern-card group overflow-hidden p-0">
        <img 
          src="/spooky-grupo.webp" 
          alt="Spooky Game Dev UPN 2026 - Group photo"
          class="w-full h-auto transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
        <div class="p-4 bg-surface/50">
          <p class="text-light/70 text-xs text-center">Event group photo on stage</p>
        </div>
      </div>
      <div class="modern-card group overflow-hidden p-0">
        <img 
          src="/spooky-equipo.webp" 
          alt="Spooky Game Dev UPN 2026 - Organizing team"
          class="w-full h-auto transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
        <div class="p-4 bg-surface/50">
          <p class="text-light/70 text-xs text-center">Organizing team</p>
        </div>
      </div>
    </div>
  </div>
</section>
