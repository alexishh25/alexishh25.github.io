---
import { getLangFromUrl, useTranslations } from '../i18n';
import { projects } from '../data/projects';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="projects" class="py-24 px-4">
  <div class="container-dashboard">
    <h2 class="section-title">{t('projects.title')}</h2>
    
    <div class="flex justify-center gap-3 mb-16 flex-wrap">
      <button data-filter="all" class="filter-btn active pixel-button text-light border-light">
        {t('projects.filter.all')}
      </button>
      <button data-filter="game" class="filter-btn pixel-button text-primary border-primary">
        {t('projects.filter.games')}
      </button>
      <button data-filter="software" class="filter-btn pixel-button text-accent border-accent">
        {t('projects.filter.software')}
      </button>
    </div>
    
    <div class="grid-modern">
      {projects.map((project) => (
        <article class={`modern-card project-card group`} data-category={project.category}>
          <div class="mb-6 overflow-hidden rounded-lg">
            {project.image ? (
              <img 
                src={project.image} 
                alt={project.title} 
                class="w-full h-56 object-cover transition-transform duration-500 group-hover:scale-110" 
              />
            ) : (
              <div class="placeholder-project">
                <span>{t('projects.placeholder')}</span>
              </div>
            )}
          </div>
          
          <div class="flex items-center gap-2 mb-4">
            <span class={`w-2 h-2 rounded-full ${project.category === 'game' ? 'bg-primary' : 'bg-accent'}`}></span>
            <span class="text-xs text-light/60 uppercase tracking-wider">
              {project.category === 'game' ? t('projects.filter.games') : t('projects.filter.software')}
            </span>
            {project.date && (
              <span class="ml-auto text-xs text-light/40">{project.date}</span>
            )}
          </div>
          
          <h3 class="text-primary font-pixel text-sm md:text-base mb-4 leading-relaxed">{project.title}</h3>
          
          <p class="text-light/70 text-sm mb-6 leading-relaxed">
            {project.description[lang]}
          </p>
          
          <div class="flex flex-wrap gap-2 mb-6">
            {project.tech.slice(0, 4).map((tech) => (
              <span class="badge-tech">{tech}</span>
            ))}
            {project.tech.length > 4 && (
              <span class="badge-tech opacity-60">+{project.tech.length - 4}</span>
            )}
          </div>
          
          <div class="flex gap-4 pt-4 border-t border-border">
            {project.demo && (
              <a 
                href={project.demo} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-accent text-sm font-semibold hover:underline flex items-center gap-2 transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                {t('projects.view')}
              </a>
            )}
            {project.repo && (
              <a 
                href={project.repo} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-light/80 text-sm font-semibold hover:underline flex items-center gap-2 transition-colors hover:text-light"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                {t('projects.repo')}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');
    
    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        
        filterButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        
        projectCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'block';
            card.classList.add('animate-in');
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .filter-btn.active {
    background-color: currentColor;
    color: var(--color-secondary);
  }
</style>
