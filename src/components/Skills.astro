---
import { getLangFromUrl, useTranslations } from '../i18n';
import { skillCategories, certifications } from '../data/skills';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const levelColors = {
  advanced: 'text-primary border-primary bg-primary/10',
  intermediate: 'text-accent border-accent bg-accent/10',
  basic: 'text-light border-border bg-light/5',
};
---

<section id="skills" class="py-24 px-4 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-surface/20 to-transparent pointer-events-none"></div>
  <div class="container-dashboard relative">
    <h2 class="section-title">{t('skills.title')}</h2>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      {Object.entries(skillCategories).map(([key, category]) => (
        <div class="modern-card">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center border border-primary/30">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
              </svg>
            </div>
            <h3 class="text-accent font-pixel text-sm md:text-base">
              {t(`skills.${category.title}`)}
            </h3>
          </div>
          
          <div class="flex flex-wrap gap-2">
            {category.items.map((skill) => (
              <span class={`badge-tech ${levelColors[skill.level]}`}>
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
    
    <div class="modern-card max-w-4xl mx-auto">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center border border-accent/30">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
          </svg>
        </div>
        <h3 class="text-accent font-pixel text-sm md:text-base">
          {t('certifications.title')}
        </h3>
      </div>
      
      <ul class="space-y-4">
        {certifications.map((cert, index) => (
          <li class="flex flex-col md:flex-row md:items-center md:justify-between p-4 bg-surface/50 rounded-lg border border-border hover:border-accent/50 transition-colors">
            <div class="flex items-start gap-3 flex-1">
              <span class="text-accent font-pixel text-lg mt-0.5">{index + 1}.</span>
              <div>
                <p class="text-light font-semibold text-sm md:text-base">{cert.name[lang]}</p>
                <p class="text-light/60 text-xs md:text-sm mt-1">{cert.issuer}</p>
              </div>
            </div>
            <span class="mt-2 md:mt-0 ml-8 md:ml-4 inline-block px-3 py-1 bg-accent/10 rounded-md text-accent text-xs font-mono border border-accent/30">
              {cert.date}
            </span>
          </li>
        ))}
      </ul>
    </div>
    
    <div class="flex flex-wrap justify-center gap-8 mt-12 text-xs">
      <div class="flex items-center gap-3">
        <span class="w-6 h-6 rounded border-2 border-primary bg-primary/10"></span>
        <span class="text-light/70 font-medium">{t('skills.level.advanced')}</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="w-6 h-6 rounded border-2 border-accent bg-accent/10"></span>
        <span class="text-light/70 font-medium">{t('skills.level.intermediate')}</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="w-6 h-6 rounded border-2 border-border bg-light/5"></span>
        <span class="text-light/70 font-medium">{t('skills.level.basic')}</span>
      </div>
    </div>
  </div>
</section>
