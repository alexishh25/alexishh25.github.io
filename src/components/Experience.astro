---
import { getLangFromUrl, useTranslations } from '../i18n';
import { experiences } from '../data/experience';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="experience" class="py-24 px-4 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-surface/20 to-transparent pointer-events-none"></div>
  <div class="container-dashboard relative">
    <h2 class="section-title">{t('experience.title')}</h2>
    
    <div class="max-w-4xl mx-auto space-y-6">
      {experiences.map((exp, index) => (
        <article class="modern-card group" style={`animation-delay: ${index * 0.1}s`}>
          <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between mb-6">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <div class={`w-3 h-3 rounded-full ${exp.type === 'game' ? 'bg-primary' : 'bg-accent'} pixel-pulse`}></div>
                <h3 class="text-primary font-pixel text-sm md:text-base">
                  {exp.title[lang]}
                </h3>
              </div>
              <p class="text-accent font-semibold text-lg md:text-xl mb-2">
                {exp.company}
              </p>
            </div>
            <div class="mt-2 lg:mt-0">
              <span class="inline-block px-4 py-2 bg-surface rounded-lg text-light/70 text-sm border border-border">
                {exp.period[lang]}
              </span>
            </div>
          </div>
          
          <ul class="space-y-3">
            {exp.description[lang].map((item) => (
              <li class="flex items-start gap-3 text-light/70 text-sm leading-relaxed">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
