---
import { getLangFromUrl, useTranslations } from '../i18n';
import { experiences } from '../data/experience';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="experience" class="py-20 px-4 bg-dark/50">
  <div class="container mx-auto max-w-4xl">
    <h2 class="section-title">{t('experience.title')}</h2>
    
    <div class="space-y-8">
      {experiences.map((exp) => (
        <article class="retro-card">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
            <div>
              <h3 class="text-primary font-pixel text-sm md:text-base mb-2">
                {exp.title[lang]}
              </h3>
              <p class="text-accent font-bold text-base md:text-lg mb-1">
                {exp.company}
              </p>
            </div>
            <span class="text-light/70 text-sm mt-2 md:mt-0">
              {exp.period[lang]}
            </span>
          </div>
          
          <ul class="list-disc list-inside space-y-2 text-light/80 text-sm leading-relaxed">
            {exp.description[lang].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
