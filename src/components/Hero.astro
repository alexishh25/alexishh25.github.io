---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="home" class="min-h-screen flex items-center justify-center pt-20 px-4 hero-gradient">
  <div class="container-dashboard max-w-5xl">
    <div class="text-center animate-in">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/30 mb-6">
          <span class="status-dot status-active"></span>
          <span class="text-accent text-sm font-medium">Available for opportunities</span>
        </div>
      </div>
      
      <h1 class="text-4xl md:text-7xl lg:text-8xl text-light mb-6 leading-tight tracking-tight">
        <span class="text-primary">ALEXIS</span> HERENCIA
      </h1>
      
      <h2 class="text-base md:text-xl lg:text-2xl text-accent font-pixel mb-8 leading-relaxed">
        {t('hero.title')}
      </h2>
      
      <p class="text-light/80 text-base md:text-lg lg:text-xl max-w-3xl mx-auto mb-12 leading-relaxed font-light">
        {t('hero.description')}
      </p>
      
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="#projects" class="pixel-button text-primary border-primary relative z-10">
          {t('hero.cta.projects')}
        </a>
        <a 
          href="https://drive.google.com/file/d/1XGkoYSwdXOiDNhyUj1NG4HE6l_9-JoM4/view" 
          target="_blank"
          rel="noopener noreferrer"
          class="pixel-button text-light border-light relative z-10"
        >
          {t('hero.cta.cv')}
        </a>
      </div>
      
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <div class="metric-card">
          <div class="metric-value">8+</div>
          <div class="metric-label">Projects</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">2</div>
          <div class="metric-label">Companies</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">1</div>
          <div class="metric-label">Event Organized</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">30+</div>
          <div class="metric-label">Attendees</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }
    h2 {
      font-size: 0.75rem;
    }
    
    .metric-card {
      padding: 1rem;
    }
    
    .metric-value {
      font-size: 1.5rem;
    }
    
    .metric-label {
      font-size: 0.75rem;
    }
  }
</style>
