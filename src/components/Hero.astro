---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="home" class="min-h-screen flex items-center justify-center pt-20 px-4">
  <div class="container mx-auto max-w-4xl text-center">
    <div class="animate-in">
      <h1 class="text-4xl md:text-6xl text-primary mb-4 leading-tight">
        ALEXIS HERENCIA
      </h1>
      <h2 class="text-lg md:text-xl text-accent font-display mb-8">
        {t('hero.title')}
      </h2>
      <p class="text-light/90 text-base md:text-lg max-w-2xl mx-auto mb-12 leading-relaxed">
        {t('hero.description')}
      </p>
      
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="#projects" class="pixel-button text-primary hover:bg-primary hover:text-secondary">
          {t('hero.cta.projects')}
        </a>
        <a 
          href="https://drive.google.com/file/d/1XGkoYSwdXOiDNhyUj1NG4HE6l_9-JoM4/view" 
          target="_blank"
          rel="noopener noreferrer"
          class="pixel-button text-accent hover:bg-accent hover:text-secondary"
        >
          {t('hero.cta.cv')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    h1 {
      font-size: 1.5rem;
    }
    h2 {
      font-size: 0.875rem;
    }
  }
</style>
